# Maintainer: Jethro Jones <jethro@jethrojones.com>

pkgname=omapresent
pkgver=0.1.0
pkgrel=1
pkgdesc='Dead-simple, Markdown-only presentation app built with Qt Quick'
arch=('x86_64')
url='https://github.com/jethrojones/omapresent'
license=('MIT')
install='omapresent.install'
depends=(
  'qt6-base'
  'qt6-declarative'
  'qt6-quickcontrols2'
  'qt6-webengine'
  'qt6-multimedia'
  'xdg-desktop-portal'
  'gst-plugins-base'
  'gst-plugins-good'
  'gst-plugins-bad'
  'gst-plugins-ugly'
)
makedepends=(
  'gcc'
  'make'
  'qt6-base'
  'qt6-declarative'
  'qt6-webengine'
  'qt6-multimedia'
)
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  /usr/bin/install -Dm755 build/omapresent "$pkgdir/usr/bin/omapresent"
  /usr/bin/install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  /usr/bin/install -Dm644 NOTICE "$pkgdir/usr/share/licenses/$pkgname/NOTICE"
  /usr/bin/install -Dm644 welcome/welcome.md "$pkgdir/usr/share/$pkgname/welcome.md"

  # Install bundled agent skill
  /usr/bin/install -d "$pkgdir/usr/share/$pkgname/skill/reference"
  /usr/bin/install -Dm644 skill/SKILL.md "$pkgdir/usr/share/$pkgname/skill/SKILL.md"
  /usr/bin/install -Dm644 skill/reference/*.md "$pkgdir/usr/share/$pkgname/skill/reference/"

  # Desktop integration
  /usr/bin/install -Dm644 "$startdir/omapresent.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/omapresent.svg"
  /usr/bin/install -Dm644 "$startdir/omapresent.desktop" "$pkgdir/usr/share/applications/omapresent.desktop"
}
